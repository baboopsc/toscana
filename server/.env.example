# Bu dosyayı ".env" adıyla kopyalayın ya da kök klasörde "npm run setup" çalıştırın.

# PostgreSQL bağlantısı: postgresql://KULLANICI:ŞİFRE@SUNUCU:PORT/VERİTABANI
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/toscana"

# Oturum anahtarı: en az 32 karakterlik rastgele bir metin
JWT_SECRET="bu-metni-uzun-ve-rastgele-bir-metinle-degistirin"

# Sunucu portu ve dinlenecek adres (0.0.0.0 = yerel ağdaki tüm cihazlar erişebilir)
PORT=3000
HOST=0.0.0.0
